# Copy to .env. With nothing set, the app runs on the built-in mock model (great for demos/tests).

# --- Option A: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-5-5

# --- Option B: any OpenAI-compatible API (set LLM_PROVIDER=openai)
# Groq (free tier):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# Gemini (free tier, OpenAI-compat endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
#
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  (no key needed)

# --- Tuning
# PORT=8787
# UPSTREAM_TIMEOUT_MS=90000
# RATE_LIMIT_PER_MIN=12
# MAX_CONCURRENT=8

# Gemini 3.x: SSE streaming stalls on the compat endpoint, so disable it:
# LLM_STREAM=false
